@startuml 02-staff-db

skinparam linetype ortho
skinparam entity {
  FontStyle bold
}
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11

entity "auth_user\n(Django built-in)" as auth_user {
  * id : INTEGER <<PK>>
  --
  username : VARCHAR(150) <<UNIQUE>>
  email : VARCHAR(254)
  password : VARCHAR(128)
  is_active : BOOLEAN
  is_staff : BOOLEAN
  is_superuser : BOOLEAN
  date_joined : DATETIME
}

entity "authtoken_token\n(DRF built-in)" as authtoken_token {
  * key : VARCHAR(40) <<PK>>
  --
  # user_id : INTEGER <<FK → auth_user.id>>
  created : DATETIME
}

entity "staff_staff" as Staff {
  * id : INTEGER <<PK, AUTO>>
  --
  # user_id : INTEGER <<FK → auth_user.id, nullable>>
  name : VARCHAR(255)
  email : VARCHAR(254) <<UNIQUE>>
  phone : VARCHAR(20)
  position : VARCHAR(100) [default='Employee']
  created_at : DATETIME
  updated_at : DATETIME
}

entity "staff_staffprofile" as StaffProfile {
  * id : INTEGER <<PK, AUTO>>
  --
  # staff_id : INTEGER <<FK → staff_staff.id>>
  department : VARCHAR(100)
  bio : TEXT
  avatar_url : VARCHAR(200)
  updated_at : DATETIME
}

entity "staff_staffroleassignment" as StaffRoleAssignment {
  * id : INTEGER <<PK, AUTO>>
  --
  # staff_id : INTEGER <<FK → staff_staff.id>>
  role_name : VARCHAR(100)
  scope : VARCHAR(100)
  is_active : BOOLEAN [default=True]
  assigned_at : DATETIME
  --
  UNIQUE (staff_id, role_name, scope)
}

entity "staff_staffactivitylog" as StaffActivityLog {
  * id : INTEGER <<PK, AUTO>>
  --
  # staff_id : INTEGER <<FK → staff_staff.id>>
  action : VARCHAR(100)
  target_type : VARCHAR(100)
  target_id : VARCHAR(100)
  metadata : JSON
  created_at : DATETIME
  --
  INDEX (staff_id, action)
  INDEX (created_at)
}

auth_user ||--o| Staff : "user_id (OneToOne, nullable)"
auth_user ||--|| authtoken_token : "user_id (OneToOne)"
Staff ||--|| StaffProfile : "staff_id (OneToOne)\nrelated_name='profile_detail'"
Staff ||--o{ StaffRoleAssignment : "staff_id (ForeignKey)\nrelated_name='role_assignments'"
Staff ||--o{ StaffActivityLog : "staff_id (ForeignKey)\nrelated_name='activity_logs'"

note bottom of StaffRoleAssignment
  UniqueConstraint:
  (staff_id, role_name, scope)
end note

note top of authtoken_token
  Token-based auth.
  Created via Token.objects.get_or_create(user=user)
  in login view.
end note

@enduml
