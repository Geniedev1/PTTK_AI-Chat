# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here

# MySQL - Staff Service
STAFF_DB_NAME=staff_db
STAFF_DB_USER=root
STAFF_DB_PASSWORD=password
STAFF_DB_HOST=staff-db
STAFF_DB_PORT=3306

# MySQL - Customer Service
CUSTOMER_DB_NAME=customer_db
CUSTOMER_DB_USER=root
CUSTOMER_DB_PASSWORD=password
CUSTOMER_DB_HOST=customer-db
CUSTOMER_DB_PORT=3306

# PostgreSQL - Cart Service
CART_DB_NAME=cart_db
CART_DB_USER=postgres
CART_DB_PASSWORD=postgres
CART_DB_HOST=cart-db
CART_DB_PORT=5432

# PostgreSQL - Laptop Service
LAPTOP_DB_NAME=laptop_db
LAPTOP_DB_USER=postgres
LAPTOP_DB_PASSWORD=postgres
LAPTOP_DB_HOST=laptop-db
LAPTOP_DB_PORT=5432

# PostgreSQL - Clothes Service
CLOTHES_DB_NAME=clothes_db
CLOTHES_DB_USER=postgres
CLOTHES_DB_PASSWORD=postgres
CLOTHES_DB_HOST=clothes-db
CLOTHES_DB_PORT=5432

# Service URLs
LAPTOP_SERVICE_URL=http://laptop-service:8004
CLOTHES_SERVICE_URL=http://clothes-service:8005

# Nginx
API_GATEWAY_HOST=api-gateway
API_GATEWAY_PORT=80
