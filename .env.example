# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here

# MySQL - Staff Service
STAFF_DB_NAME=staff_db
STAFF_DB_USER=root
STAFF_DB_PASSWORD=password
STAFF_DB_HOST=staff-db
STAFF_DB_PORT=3306

# MySQL - Customer Service
CUSTOMER_DB_NAME=customer_db
CUSTOMER_DB_USER=root
CUSTOMER_DB_PASSWORD=password
CUSTOMER_DB_HOST=customer-db
CUSTOMER_DB_PORT=3306

# PostgreSQL - Cart Service
CART_DB_NAME=cart_db
CART_DB_USER=postgres
CART_DB_PASSWORD=postgres
CART_DB_HOST=cart-db
CART_DB_PORT=5432

# PostgreSQL - Product Service
PRODUCT_DB_NAME=product_db
PRODUCT_DB_USER=postgres
PRODUCT_DB_PASSWORD=postgres
PRODUCT_DB_HOST=product-db
PRODUCT_DB_PORT=5432

# PostgreSQL - Order Service
ORDER_DB_NAME=order_db
ORDER_DB_USER=postgres
ORDER_DB_PASSWORD=postgres
ORDER_DB_HOST=order-db
ORDER_DB_PORT=5432

# Service URLs
PRODUCT_SERVICE_URL=http://product-service:8004
CART_SERVICE_URL=http://cart-service:8003
ORDER_SERVICE_URL=http://order-service:8005
CUSTOMER_SERVICE_URL=http://customer-service:8002
STAFF_SERVICE_URL=http://staff-service:8001

# Nginx
API_GATEWAY_HOST=api-gateway
API_GATEWAY_PORT=80
INTERNAL_ADMIN_KEY=change-this-in-dev
